{
  "name": "@gadgets/workshop-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "wrangler deploy",
    "build:worker": "node build-browser-runtime.mjs && pnpm exec capnweb-validate build --out .wrangler/validate",
    "clean": "rm -rf dist",
    "test:integration": "node build-browser-runtime.mjs && node scripts/build-format-blueprints.ts && vitest run --config vitest.integration.config.ts",
    "test:run": "node build-browser-runtime.mjs && node scripts/build-format-blueprints.ts && vitest run && vitest run --config vitest.integration.config.ts",
    "test:watch": "node build-browser-runtime.mjs && node scripts/build-format-blueprints.ts && vitest",
    "import:format-blueprint": "node scripts/import-format-blueprint.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.4",
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/typed-storage": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:",
    "diff": "catalog:",
    "diff3": "^0.0.3",
    "isomorphic-git": "^1.40.0",
    "jose": "^6.2.8",
    "pako": "^2.1.0",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@cloudflare/kumo": "^2.9.2",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@dagrejs/dagre": "^2.0.4",
    "@phosphor-icons/react": "^2.1.10",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "@gadgets/scripts": "workspace:*",
    "@types/pako": "^2.0.4",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "world-atlas": "^2.0.2",
    "wrangler": "catalog:"
  }
}
